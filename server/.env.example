# ===== Database (required) =====
# Format:
# postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psyav?schema=public"

# ===== Runtime (optional but recommended) =====
NODE_ENV="development"

# If your server uses PORT in code later (common pattern)
PORT=3001

# ===== CORS / URLs (optional, but you'll likely need soon) =====
# Frontend URL for CORS allowlist and links in emails
CLIENT_URL="http://localhost:5173"